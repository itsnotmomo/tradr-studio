<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The News scout (scripts/news/scout.sh run), 08:00 and 17:00 in the Mac's time zone (Europe/Rome).
     Also at load (boot/login) and every 15 min: scout.sh runs a missed slot once if it is < 12 h old (Mac off, asleep
     with the lid closed, or a failed run), and otherwise exits quietly. Install:
     cp scripts/news/scout.plist ~/Library/LaunchAgents/me.tradr.news-scout.plist
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/me.tradr.news-scout.plist
     Change the times: edit Hour/Minute below, copy again, then bootout + bootstrap. See docs/media-playbook.md §15. -->
<plist version="1.0"><dict>
  <key>Label</key><string>me.tradr.news-scout</string>
  <key>WorkingDirectory</key><string>/Users/mohamedharchi/Desktop/tradrig</string>
  <key>ProgramArguments</key><array>
    <!-- Started through node, which already has macOS's Desktop permission (as the poster agent): /bin/zsh started by
         launchd can't read ~/Desktop, and the shell and claude inherit node's access. -->
    <string>/Users/mohamedharchi/.nvm/versions/node/v20.19.5/bin/node</string><string>-e</string>
    <string>process.exitCode = require("child_process").spawnSync("/bin/zsh", ["/Users/mohamedharchi/Desktop/tradrig/scripts/news/scout.sh", "run"], { stdio: "inherit" }).status ?? 1</string>
  </array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/mohamedharchi/Library/Logs/tradr-news-scout/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/mohamedharchi/Library/Logs/tradr-news-scout/launchd.log</string>
</dict></plist>
